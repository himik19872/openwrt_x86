config upsmon 'upsmon'
	option minsupplies '1'
	option shutdowncmd '/usr/sbin/nutshutdown'
	option pollfreq '5'
	option pollfreqalert '5'
	option hostsync '15'
	option deadtime '15'
	option notifycmd '/usr/libexec/nut-telegram'
	option onlinenotify 'SYSLOG+EXEC'
	option onbattnotify 'SYSLOG+EXEC'
	option lowbattnotify 'SYSLOG+EXEC'
	option fsdnotify 'SYSLOG+EXEC'
	option commoknotify 'SYSLOG+EXEC'
	option commbadnotify 'SYSLOG+EXEC'
	option shutdownnotify 'SYSLOG+EXEC'
	option replbattnotify 'SYSLOG+EXEC'
	option lowbatnotify 'SYSLOG+EXEC'

config master 'master'
	option upsname 'ups'
	option hostname 'localhost'
	option powervalue '1'
	option username 'monuser'
	option password 'CHANGE_ME_STRONG_PASSWORD'
