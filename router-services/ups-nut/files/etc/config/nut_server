config driver 'ups'
	option driver 'usbhid-ups'
	option port 'auto'
	option vendorid '06da'
	option productid 'ffff'
	option desc 'PPC HID UPS'
	option pollinterval '5'

config user 'monuser'
	option username 'monuser'
	option password 'CHANGE_ME_STRONG_PASSWORD'
	option upsmon 'master'
	option actions 'set fsd'
	list instcmd 'test.battery.start'
	list instcmd 'beeper.toggle'

config listen_address 'local'
	option address '127.0.0.1'
	option port '3493'

config listen_address 'lan'
	option address '192.168.1.1'
	option port '3493'

config upsd 'upsd'
	option maxage '15'
	option maxconn '24'
