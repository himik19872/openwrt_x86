#!/bin/sh
# /usr/libexec/duckdns-apply
# Генерирует конфиги nginx (443, роутинг по server_name) и dnsmasq (split-horizon)
# из /etc/duckdns/sites.json и применяет их.

JSON=${1:-/etc/duckdns/sites.json}
NGX=/etc/nginx/conf.d/duckdns.conf
DNSF=/etc/dnsmasq.d/duckdns.conf
CERT=/etc/nginx/ssl/ha.crt
KEY=/etc/nginx/ssl/ha.key

[ -f "$JSON" ] || { echo "ERROR: $JSON not found" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo "ERROR: jq not found" >&2; exit 1; }
jq -e . "$JSON" >/dev/null 2>&1 || { echo "ERROR: invalid JSON in $JSON" >&2; exit 1; }

BASE=$(jq -r '.base // "himik1987.duckdns.org"' "$JSON")
LISTEN_IP=$(jq -r '.listen_ip // "192.168.1.1"' "$JSON")
LOCAL_DOMAIN=$(jq -r 'if .local_domain == true then "1" else "0" end' "$JSON")
N=$(jq -r '.sites | length' "$JSON")

NGX_NEW=$(mktemp /tmp/duckdns-ngx.XXXXXX) || exit 1
DNS_NEW=$(mktemp /tmp/duckdns-dns.XXXXXX) || exit 1

cat > "$NGX_NEW" <<EOF
# AUTO-GENERATED by /usr/libexec/duckdns-apply -- do not edit
# Источник: $JSON

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;
    ssl_certificate     $CERT;
    ssl_certificate_key $KEY;
    return 302 https://$BASE\$request_uri;
}
EOF

printf '# AUTO-GENERATED by /usr/libexec/duckdns-apply -- do not edit\n' > "$DNS_NEW"

i=0
while [ "$i" -lt "$N" ]; do
    sub=$(jq -r ".sites[$i].sub // \"\"" "$JSON")
    tgt=$(jq -r ".sites[$i].target // empty" "$JSON")
    pub=$(jq -r "if .sites[$i].public == true then 1 else 0 end" "$JSON")
    en=$(jq -r "if .sites[$i].enabled == false then 0 else 1 end" "$JSON")
    ws=$(jq -r "if .sites[$i].ws == true then 1 else 0 end" "$JSON")
    ver=$(jq -r "if .sites[$i].verify == true then 1 else 0 end" "$JSON")

    if [ "$sub" = "null" ]; then sub=""; fi
    if [ -n "$sub" ]; then fqdn="$sub.$BASE"; else fqdn="$BASE"; fi

    {
        echo ""
        echo "server {"
        echo "    listen 443 ssl;"
        echo "    listen [::]:443 ssl;"
        echo "    http2 on;"
        echo "    server_name $fqdn;"
        echo "    ssl_certificate     $CERT;"
        echo "    ssl_certificate_key $KEY;"
        echo "    ssl_protocols TLSv1.2 TLSv1.3;"
        echo ""
        if [ "$pub" = "0" ]; then
            echo "    # только из локальной сети / WireGuard"
            echo "    allow 192.168.1.0/24;"
            echo "    allow 127.0.0.0/8;"
            echo "    allow 10.66.66.0/24;"
            echo "    deny all;"
            echo ""
        fi
        if [ "$en" = "0" ]; then
            echo "    return 503;"
        else
            # отделяем origin от пути (например http://127.0.0.1/cgi-bin/upsadmin)
            case "$tgt" in
                *://*) scheme=${tgt%%://*} ; rest=${tgt#*://} ;;
                *) scheme=http ; rest=$tgt ;;
            esac
            hostport=${rest%%/*}
            tpath=""
            case "$rest" in
                */*) tpath="/${rest#*/}" ;;
            esac
            case "$tpath" in
                "/" | "") tpath="" ;;
            esac
            origin="$scheme://$hostport"

            echo "    location / {"
            if [ -n "$tpath" ]; then
                echo "        rewrite ^ $tpath\$uri break;"
            fi
            echo "        proxy_pass $origin;"
            echo "        proxy_http_version 1.1;"
            echo "        proxy_set_header Host \$host;"
            echo "        proxy_set_header X-Real-IP \$remote_addr;"
            echo "        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;"
            echo "        proxy_set_header X-Forwarded-Proto \$scheme;"
            if [ "$ws" = "1" ]; then
                echo "        proxy_set_header Upgrade \$http_upgrade;"
                echo "        proxy_set_header Connection \$connection_upgrade;"
            fi
            case "$origin" in
                https://*)
                    [ "$ver" = "0" ] && echo "        proxy_ssl_verify off;"
                    echo "        proxy_ssl_server_name on;"
                    ;;
            esac
            echo "        proxy_read_timeout 3600s;"
            echo "        proxy_send_timeout 3600s;"
            echo "        proxy_buffering off;"
            echo "    }"
        fi
        echo "}"
    } >> "$NGX_NEW"

    echo "address=/$fqdn/$LISTEN_IP" >> "$DNS_NEW"

    i=$((i + 1))
done

if [ "$LOCAL_DOMAIN" = "1" ]; then
    echo "# локальный домен: не форвардить наружу неизвестные имена"
    echo "local=/$BASE/" >> "$DNS_NEW"
fi

RC_NGX=0
cp -f "$NGX" "$NGX.bak" 2>/dev/null
cp -f "$NGX_NEW" "$NGX" 2>/dev/null || RC_NGX=1
if [ "$RC_NGX" = "0" ]; then
    if nginx -t >/tmp/duckdns-nginx-test.log 2>&1; then
        /etc/init.d/nginx reload >/dev/null 2>&1 || RC_NGX=1
    else
        cp -f "$NGX.bak" "$NGX" 2>/dev/null
        RC_NGX=1
    fi
fi

# dnsmasq: включаем confdir и (опционально) локальный домен
confdir=$(uci -q get dhcp.@dnsmasq[0].confdir)
if [ "$confdir" != "/etc/dnsmasq.d" ]; then
    uci set dhcp.@dnsmasq[0].confdir='/etc/dnsmasq.d'
    uci commit dhcp
fi

mkdir -p /etc/dnsmasq.d
cp -f "$DNS_NEW" "$DNSF"
if [ "$LOCAL_DOMAIN" = "1" ]; then
    [ "$(uci -q get dhcp.@dnsmasq[0].domain)" != "$BASE" ] && {
        uci set dhcp.@dnsmasq[0].domain="$BASE"
        uci commit dhcp
    }
else
    [ "$(uci -q get dhcp.@dnsmasq[0].domain)" = "$BASE" ] && {
        uci set dhcp.@dnsmasq[0].domain='lan'
        uci commit dhcp
    }
fi
/etc/init.d/dnsmasq reload >/dev/null 2>&1

rm -f "$NGX_NEW" "$DNS_NEW"

if [ "$RC_NGX" = "1" ]; then
    echo "ERROR: nginx config rejected, rolled back:" >&2
    cat /tmp/duckdns-nginx-test.log 2>/dev/null >&2
    exit 1
fi

echo "OK: applied $N site(s)"
