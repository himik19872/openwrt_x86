#!/bin/sh /etc/rc.common
# Сервис автоподъёма портов при горячей замене SFP (см. /usr/bin/sfp-watchdog)

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/sfp-watchdog
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
